{
  "name": "super-react-monorepo",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "pnpm --filter super-react build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"packages/**/test/**/*.test.ts\"",
    "sr": "node --import tsx packages/cli/src/cli.ts",
    "gen-docs": "node --import tsx scripts/gen-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.28.1",
    "tsx": "4.19.2",
    "typescript": "5.8.2"
  }
}
